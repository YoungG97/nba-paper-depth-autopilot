{
  "manifest_version": 3,
  "name": "Google Flow 批量分镜投喂器 (Paper Depth Feeder)",
  "version": "1.1.0",
  "description": "专为 Google Flow 打造的批量分镜投喂与挂机助手：支持自动拖入参考图、自动切换图片/视频模式与对应秒数、一键导入新期数分镜。",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "打开 Google Flow 批量投喂侧边栏",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
